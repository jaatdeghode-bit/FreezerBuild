name: Unzip and Auto Build APK

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Unzip Project & Move Files
        run: |
          mkdir -p extracted
          unzip -o FreezerFrenzyAuto_v0.3.zip -d extracted
          # Flatten nested folder structure if present
          if [ -d extracted/FreezerFrenzyAuto_v0.3 ]; then
            cp -r extracted/FreezerFrenzyAuto_v0.3/* .
          elif [ -d extracted/* ]; then
            cp -r extracted/*/* . || true
            cp -r extracted/* . || true
          else
            cp -r extracted/* .
          fi

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Build APK
        run: |
          if [ ! -f gradlew ]; then
            gradle wrapper --gradle-version 8.1.1
          fi
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: FreezerFrenzy-APK
          path: '**/build/outputs/apk/debug/*.apk'
